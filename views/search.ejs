<%- include('partials/header') %>

<h1>Search public notes</h1>

<form method="get" action="/search" class="card">
  <label>Title contains <input name="q" value="<%= q %>" autofocus></label>
  <button type="submit">Search</button>
</form>

<% if (q) { %>
  <p>Results for: <%- q %></p>
<% } %>

<% if (error) { %>
  <pre class="error"><%= error %></pre>
<% } %>

<table class="grid">
  <thead><tr><th>id</th><th>title</th><th>body</th><th>visibility</th><th>user_id</th></tr></thead>
  <tbody>
    <% rows.forEach(function (r) { %>
      <tr>
        <td><%= r.id %></td>
        <td><%- r.title %></td>
        <td><%= r.body %></td>
        <td><%= r.visibility %></td>
        <td><%= r.user_id %></td>
      </tr>
    <% }) %>
    <% if (rows.length === 0) { %><tr><td colspan="5" class="muted">No rows.</td></tr><% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
