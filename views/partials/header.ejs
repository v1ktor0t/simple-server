<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VulnShop Portal</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="banner">Training application. It contains defects on purpose.</div>
  <nav>
    <a class="brand" href="/dashboard">VulnShop Portal</a>
    <% if (currentUser) { %>
      <a href="/dashboard">Notes</a>
      <a href="/search">Search</a>
      <a href="/profile/<%= currentUser.id %>">Profile</a>
      <% if (currentUser.role === 'admin') { %><a href="/admin">Admin</a><% } %>
      <span class="spacer"></span>
      <span class="who"><%= currentUser.username %> (<%= currentUser.role %>)</span>
      <form method="post" action="/logout"><button class="link">Log out</button></form>
    <% } %>
  </nav>
  <main>
    <% if (flash) { %><p class="flash"><%= flash %></p><% } %>
